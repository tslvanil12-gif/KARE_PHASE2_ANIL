//  IMPLACE METHOD
//   I/P                      O/P 
//   5                     50 40 30 20 10
//  10 20 30 40 50   
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n]; 
        int i;
        for(i=0;i<n;i++)
        arr[i]=sc.nextInt();
        int s = 0;
        int e = n-1;
        while(s<e){
            int temp=arr[s];
            arr[s]=arr[e];
            arr[e]=temp;
            s++;
            e--;
        }
        for(i=0;i<n;i++)
        System.out.print(arr[i] + " ");
    }
}
