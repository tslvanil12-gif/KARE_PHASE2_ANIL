// STRONG NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n;
        int fact,sum=0,d;
        while(n!=0){
            fact=1;
            d=n%10;
            for(int i = 1; i <= d; i++)
            fact = fact * i;
            sum = sum+fact;
            n=n/10;
        }
        if(temp==sum)
        System.out.print("Strong Number");
        else
        System.out.print("Not a strong number");
    }
}

// ARMSTRONG NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n, c=0;
        int sum=0,d;
        while(n!=0){
            n=n/10;
            c++;
        }
        n=temp;
        while(n!=0){
            d=n%10;
            sum=sum+(int)Math.pow(d,c);
            n=n/10;
        }
        if(temp==sum)
        System.out.print("Armstrong Number");
        else
        System.out.print("Not a armstrong number");
    }
}

// ADAM NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sn = n*n;
        int rn=0,srn,ans=0,d;
        while(n!=0){
            d = n%10;
            rn = rn*10+d;
            n=n/10;
        }
        srn = rn * rn;
        while(srn!=0){
            d=srn%10;
            ans=ans*10+d;
            srn=srn/10;
        }
        if(sn == ans)
        System.out.print("Adam Number");
        else
        System.out.print("Not a adam number");
    }
}

// AMICABLE PAIR
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n1 = sc.nextInt();
        int n2 = sc.nextInt();
        int s1=0,s2=0;
        for(int i=1; i<=n1/2;i++){
            if(n1%i==0)
            s1 = s1+i;
        }
        for(int i = 1; i<=n2/2;i++){
            if(n2%i==0)
            s2 = s2 + i;
        }
        if(s1 == n2 && s2 == n1)
        System.out.print("Amicable Pair");
        else
        System.out.print("Not a amicable pair");
    }
}

// PRIME NUMBER
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int c=0,flag=0,i;
        if(n==1){
            System.out.print("Neither prime nor composite");
            return;
        }
        for(i = 2; i <= n/2; i++){
            if(n%i==0){
                c++;
                flag=1;
                System.out.print("Not a Prime Number");
            }
        }
        if(flag==0)
        System.out.print("Prime Number");
    }
}

// PRIME NUMBER WITHIN A CERTAIN RANGE
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n1 = sc.nextInt();
        int n2 = sc.nextInt();
        int c,i,j;
        for(j = n1; j<=n2; j++){
            c=0;
            for(i = 2; i <= j/2; i++){
                if(j%i==0){
                c++;
                break;}
            }
            if(c==0)
            System.out.print(j + " ");
        }
    }
}
